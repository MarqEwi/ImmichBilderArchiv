# Vorlage fuer immich/.env - hier stehen nur Platzhalter, keine echten Werte.
# Kopieren nach .env und DB_PASSWORD ersetzen, z. B. mit:

# Arbeitsdaten von Immich (upload, thumbs, encoded-video, profile, backups). Enthaelt Leerzeichen,
# deshalb in Anfuehrungszeichen.
# Windows-Sicht: Freigabe personal_folder auf STEVENAS, darin "Steves Bilder Archiv", Unterordner "_System"
UPLOAD_LOCATION="/volume1/@home/MarcEwers/Steves Bilder Archiv/_System"

# Das eigentliche Archiv (Jahres- und Ereignisordner). Wird im Container unter
# /data/library/admin eingehaengt, also dort, wo Immich die Dateien des Benutzers admin ablegt.
ARCHIV_LOCATION="/volume1/@home/MarcEwers/Steves Bilder Archiv/Archiv"

# Datenbank bewusst NICHT im Fotoordner und nicht auf einer SMB-Freigabe.
DB_DATA_LOCATION=/volume1/Grundlagen/docker/immich/postgres

# Eingangsordner fuer die External Library. Wird nur lesend eingebunden; Immich laesst die
# Dateien liegen, wo sie sind. Der Importpfad in der Oberflaeche lautet /import (Pfad im Container).
IMPORT_LOCATION="/volume1/@home/MarcEwers/Steves Bilder Archiv/import"

TZ=Europe/Berlin

# Fest gepinnt statt "release", damit Updates bewusst passieren.
IMMICH_VERSION=v3.2.4

# 32 Zeichen, nur A-Za-z0-9 (Vorgabe der Immich-Doku).
DB_PASSWORD=HIER_32_ZEICHEN_A-Za-z0-9_EINSETZEN

# Ab hier unveraendert aus example.env
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# API-Schluessel fuer den naechtlichen Anstoss der Speicher-Migration (Dienst storage-migration).
# In Immich unter Kontoeinstellungen -> API-Schluessel erzeugen.
MIGRATION_API_KEY=HIER_API_SCHLUESSEL_EINSETZEN
