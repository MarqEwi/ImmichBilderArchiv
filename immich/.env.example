# Vorlage fuer immich/.env - hier stehen nur Platzhalter, keine echten Werte.
# Kopieren nach .env und DB_PASSWORD ersetzen, z. B. mit:

# Fotoordner. Enthaelt Leerzeichen, deshalb in Anfuehrungszeichen.
# Windows-Sicht: Freigabe personal_folder auf STEVENAS, darin "Steves Bilder Archiv", Unterordner "immich"
UPLOAD_LOCATION="/volume1/@home/MarcEwers/Steves Bilder Archiv/immich"

# Datenbank bewusst NICHT im Fotoordner und nicht auf einer SMB-Freigabe.
DB_DATA_LOCATION=/volume1/Grundlagen/docker/immich/postgres

TZ=Europe/Berlin

# Fest gepinnt statt "release", damit Updates bewusst passieren.
IMMICH_VERSION=v3.2.2

# 32 Zeichen, nur A-Za-z0-9 (Vorgabe der Immich-Doku).
DB_PASSWORD=HIER_32_ZEICHEN_A-Za-z0-9_EINSETZEN

# Ab hier unveraendert aus example.env
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
